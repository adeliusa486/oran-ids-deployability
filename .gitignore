# Data: manifests and split indices are committed, payloads are not.
data/raw/
data/interim/
data/processed/
*.pcap
*.pcapng
!data/MANIFEST.json
!data/splits/**/*.json
!data/splits/**/*.npy

# Results: raw runs are large; aggregated CSVs are committed.
results/raw/
results/runtime/

# Transient run logs at the repository root are excluded. Per-experiment evidence
# logs under results/EXP-*/logs/ are COMMITTED: they are the record that a gate was
# actually executed, and an experiment report that cites an uncommitted log is an
# assertion rather than evidence. Anchored with a leading slash so the pattern does
# not swallow them.
/logs/

# Models
*.onnx
*.pkl
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# LaTeX
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk

# LaTeX build products beyond those already listed
paper/_probe.tex
paper/*.bbl
paper/*.synctex.gz
paper/*.toc

# Figure preview and verification scaffolding. The figures themselves are
# committed as .tex; these are single-figure standalone builds and page renders
# used to check the artwork, and they are regenerable from the sources.
paper/_f?prev.*
paper/_verify_page*.png
paper/_build?.log

# Icon extraction QA sheet, regenerated by scripts/extract_figure_icons.py
figures/icons/_contact.png
